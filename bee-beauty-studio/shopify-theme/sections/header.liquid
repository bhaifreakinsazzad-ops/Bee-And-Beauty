{% comment %}
  Header Section - Navigation and Cart
{% endcomment %}

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link">
      {% render 'logo' %}
    </a>
    
    <nav class="desktop-nav">
      <a href="#serum" class="nav-link">The Serum</a>
      <a href="#bundles" class="nav-link">Bundles</a>
      <a href="#gifting" class="nav-link">Gifting</a>
      <a href="#minis" class="nav-link">Minis</a>
      <a href="#story" class="nav-link">Our Story</a>
    </nav>
    
    <div class="header-actions">
      <button class="icon-btn search-toggle" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
      
      <a href="/collections/all" class="cart-link" aria-label="Shopping bag">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
      
      <button class="icon-btn mobile-menu-toggle" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
  
  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-overlay" onclick="toggleMobileMenu()"></div>
    <div class="mobile-menu-drawer">
      <button class="mobile-menu-close" onclick="toggleMobileMenu()" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      
      <nav class="mobile-nav">
        <a href="#serum" class="mobile-nav-link" onclick="toggleMobileMenu()">The Serum</a>
        <a href="#bundles" class="mobile-nav-link" onclick="toggleMobileMenu()">Bundles</a>
        <a href="#gifting" class="mobile-nav-link" onclick="toggleMobileMenu()">Gifting</a>
        <a href="#minis" class="mobile-nav-link" onclick="toggleMobileMenu()">Minis</a>
        <a href="#story" class="mobile-nav-link" onclick="toggleMobileMenu()">Our Story</a>
      </nav>
    </div>
  </div>
</header>

<script>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobileMenu');
    menu.classList.toggle('active');
    document.body.style.overflow = menu.classList.contains('active') ? 'hidden' : '';
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: hsl(var(--background) / 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid hsl(var(--border));
  }
  
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    max-width: 1280px;
    margin: 0 auto;
  }
  
  @media (min-width: 640px) {
    .header-inner {
      padding: 16px 32px;
    }
  }
  
  .logo-link {
    flex-shrink: 0;
  }
  
  .desktop-nav {
    display: none;
    gap: 28px;
  }
  
  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
  }
  
  .nav-link {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.8);
    text-decoration: none;
    transition: color 0.2s;
  }
  
  .nav-link:hover {
    color: hsl(var(--primary));
  }
  
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  @media (min-width: 640px) {
    .header-actions {
      gap: 12px;
    }
  }
  
  .icon-btn {
    background: transparent;
    border: none;
    padding: 8px;
    border-radius: 9999px;
    color: hsl(var(--foreground) / 0.7);
    cursor: pointer;
    transition: background 0.2s;
  }
  
  .icon-btn:hover {
    background: hsl(var(--accent));
  }
  
  .search-toggle {
    display: none;
  }
  
  @media (min-width: 640px) {
    .search-toggle {
      display: inline-flex;
    }
  }
  
  .cart-link {
    position: relative;
    display: inline-flex;
    padding: 8px;
    border-radius: 9999px;
    color: hsl(var(--foreground) / 0.7);
    text-decoration: none;
    transition: background 0.2s;
  }
  
  .cart-link:hover {
    background: hsl(var(--accent));
  }
  
  .cart-count {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: hsl(var(--secondary));
    color: hsl(var(--secondary-foreground));
    font-family: 'Karla', sans-serif;
    font-size: 10px;
    font-weight: 700;
    border-radius: 9999px;
    padding: 0 4px;
  }
  
  .mobile-menu-toggle {
    display: inline-flex;
  }
  
  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }
  
  /* Mobile Menu */
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
  }
  
  .mobile-menu.active {
    display: block;
  }
  
  .mobile-menu-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }
  
  .mobile-menu-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 288px;
    background: hsl(var(--background));
    padding: 24px;
    box-shadow: var(--shadow-elegant);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  
  .mobile-menu.active .mobile-menu-drawer {
    transform: translateX(0);
  }
  
  .mobile-menu-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: transparent;
    border: none;
    padding: 8px;
    border-radius: 8px;
    color: hsl(var(--foreground) / 0.7);
    cursor: pointer;
  }
  
  .mobile-menu-close:hover {
    background: hsl(var(--accent));
  }
  
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 40px;
  }
  
  .mobile-nav-link {
    padding: 10px 12px;
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: hsl(var(--foreground));
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.2s;
  }
  
  .mobile-nav-link:hover {
    background: hsl(var(--accent));
  }
</style>
