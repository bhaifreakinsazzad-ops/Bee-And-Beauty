{% comment %}
  Footer Section
{% endcomment %}

<footer class="site-footer" id="story">
  <div class="footer-container">
    <!-- Newsletter Signup -->
    <div class="footer-newsletter">
      <div class="newsletter-content">
        <h3>Join the hive.</h3>
        <p>Ingredient education, early access, and 10% off your first order.</p>
      </div>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form">
          <input 
            type="email" 
            name="contact[email]" 
            placeholder="Email address" 
            required
            class="newsletter-input"
          >
          <button type="submit" class="newsletter-btn">Subscribe</button>
        </div>
      {% endform %}
    </div>
    
    <!-- Footer Columns -->
    <div class="footer-grid">
      <div class="footer-brand">
        {% render 'logo' %}
        <p class="brand-mission">
          Bee & Beauty translates the intelligence of the hive into modern, clinically-minded skincare — pairing honey, propolis and royal jelly with proven actives.
        </p>
        <div class="social-links">
          <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>
      </div>
      
      <div class="footer-column">
        <h4>Shop</h4>
        <ul>
          <li><a href="/collections/the-ordinary-serum">The Ordinary Serum</a></li>
          <li><a href="/collections/bundles">Duo Set</a></li>
          <li><a href="/collections/gifting">Gift Set</a></li>
          <li><a href="/collections/minis">Travel Minis</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h4>Learn</h4>
        <ul>
          <li><a href="/pages/ingredient-guide">Ingredient Guide</a></li>
          <li><a href="#story">Our Story</a></li>
          <li><a href="/collections/all#reviews">Reviews</a></li>
          <li><a href="/pages/faqs">FAQs</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h4>Support</h4>
        <ul>
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/shipping-returns">Shipping & Returns</a></li>
          <li><a href="/account">Track My Order</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h4>Contact</h4>
        <ul class="contact-info">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            {{ shop.email }}
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Sourced from small apiaries, formulated for the world
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <p class="tagline">"Nature, refined."</p>
    </div>
    
    <!-- Studio Credits -->
    <div class="footer-credits">
      <p>
        A product of <strong>Freakin Studio</strong> — An AI Powered Production Studio by Whole 9 Yards of Holdings, LLC
      </p>
      <p>
        <strong>BhaiSazzaD.online</strong> is the architect behind this massive SaaS product
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: hsl(var(--plum-deep));
    color: hsl(var(--primary-foreground));
    padding: 64px 16px;
  }
  
  @media (min-width: 640px) {
    .site-footer {
      padding: 64px 32px;
    }
  }
  
  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px;
    background: hsl(var(--primary-foreground) / 0.05);
    border-radius: 24px;
    margin-bottom: 48px;
  }
  
  @media (min-width: 1024px) {
    .footer-newsletter {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  
  .newsletter-content h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 4px;
    color: hsl(var(--primary-foreground));
  }
  
  @media (min-width: 640px) {
    .newsletter-content h3 {
      font-size: 32px;
    }
  }
  
  .newsletter-content p {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    color: hsl(var(--primary-foreground) / 0.7);
    margin: 0;
  }
  
  .newsletter-form {
    display: flex;
    gap: 8px;
    flex: 1;
    max-width: 400px;
  }
  
  .newsletter-input {
    flex: 1;
    padding: 12px 16px;
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    border: 1px solid hsl(var(--primary-foreground) / 0.2);
    border-radius: 9999px;
    background: transparent;
    color: hsl(var(--primary-foreground));
  }
  
  .newsletter-input::placeholder {
    color: hsl(var(--primary-foreground) / 0.5);
  }
  
  .newsletter-btn {
    padding: 12px 24px;
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    font-weight: 600;
    background: hsl(var(--secondary));
    color: hsl(var(--secondary-foreground));
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .newsletter-btn:hover {
    background: hsl(var(--secondary) / 0.9);
  }
  
  .footer-grid {
    display: grid;
    gap: 48px;
    grid-template-columns: 1fr;
  }
  
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr repeat(4, 1fr);
      gap: 32px;
    }
  }
  
  .footer-brand {
    grid-column: 1 / -1;
  }
  
  @media (min-width: 1024px) {
    .footer-brand {
      grid-column: 1;
    }
  }
  
  .brand-mission {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: hsl(var(--primary-foreground) / 0.7);
    max-width: 320px;
    margin: 16px 0 24px;
  }
  
  .social-links {
    display: flex;
    gap: 12px;
  }
  
  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid hsl(var(--primary-foreground) / 0.2);
    border-radius: 9999px;
    color: hsl(var(--primary-foreground) / 0.8);
    transition: all 0.2s;
  }
  
  .social-links a:hover {
    border-color: hsl(var(--secondary));
    color: hsl(var(--secondary));
  }
  
  .footer-column h4 {
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--secondary));
    margin: 0 0 16px;
  }
  
  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-column li {
    margin-bottom: 10px;
  }
  
  .footer-column a {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    color: hsl(var(--primary-foreground) / 0.7);
    text-decoration: none;
    transition: color 0.2s;
  }
  
  .footer-column a:hover {
    color: hsl(var(--primary-foreground));
  }
  
  .contact-info li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    color: hsl(var(--primary-foreground) / 0.7);
  }
  
  .contact-info svg {
    margin-top: 2px;
    color: hsl(var(--secondary));
  }
  
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    margin-top: 48px;
    border-top: 1px solid hsl(var(--primary-foreground) / 0.1);
    text-align: center;
  }
  
  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  
  .footer-bottom p {
    font-family: 'Karla', sans-serif;
    font-size: 12px;
    color: hsl(var(--primary-foreground) / 0.5);
    margin: 0;
  }
  
  .tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 14px;
    font-style: italic;
    color: hsl(var(--primary-foreground) / 0.7);
  }
  
  .footer-credits {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding-top: 16px;
    margin-top: 16px;
    border-top: 1px solid hsl(var(--primary-foreground) / 0.05);
    text-align: center;
  }
  
  .footer-credits p {
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    color: hsl(var(--primary-foreground) / 0.4);
    margin: 0;
    line-height: 1.5;
  }
  
  .footer-credits strong {
    color: hsl(var(--primary-foreground) / 0.6);
    font-weight: 600;
  }
  
  @media (min-width: 640px) {
    .footer-credits {
      flex-direction: row;
      justify-content: center;
      gap: 24px;
    }
  }
</style>
