{% comment %}
  Logo Snippet - Bee & Beauty Brand Mark
{% endcomment %}

<svg class="bee-mark" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="plumGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:hsl(330.6 74.3% 27.5%)" />
      <stop offset="100%" style="stop-color:hsl(330 79.2% 9.4%)" />
    </linearGradient>
    <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:hsl(42 80% 52%)" />
      <stop offset="100%" style="stop-color:hsl(42 70.5% 69.4%)" />
    </linearGradient>
  </defs>
  
  <!-- Hexagon background -->
  <path d="M50 5 L90 27.5 L90 72.5 L50 95 L10 72.5 L10 27.5 Z" 
        fill="url(#plumGradient)" />
  
  <!-- Inner hexagon -->
  <path d="M50 15 L80 32.5 L80 67.5 L50 85 L20 67.5 L20 32.5 Z" 
        fill="none" 
        stroke="url(#goldGradient)" 
        stroke-width="2" />
  
  <!-- Bee stylized mark -->
  <ellipse cx="50" cy="45" rx="12" ry="18" fill="url(#goldGradient)" />
  <ellipse cx="50" cy="65" rx="10" ry="14" fill="url(--goldGradient)" opacity="0.8" />
  
  <!-- Wings -->
  <ellipse cx="38" cy="42" rx="8" ry="12" fill="hsl(var(--cream-bg))" opacity="0.9" />
  <ellipse cx="62" cy="42" rx="8" ry="12" fill="hsl(var(--cream-bg))" opacity="0.9" />
  
  <!-- Antennae -->
  <path d="M45 30 Q40 20 35 22" stroke="url(#goldGradient)" stroke-width="2" fill="none" />
  <path d="M55 30 Q60 20 65 22" stroke="url(#goldGradient)" stroke-width="2" fill="none" />
</svg>

<style>
  .bee-mark {
    height: 48px;
    width: auto;
  }
  
  @media (min-width: 640px) {
    .bee-mark {
      height: 56px;
    }
  }
</style>
