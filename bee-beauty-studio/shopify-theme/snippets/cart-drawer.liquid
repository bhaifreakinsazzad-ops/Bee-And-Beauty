{% comment %}
  Cart Drawer Snippet - Slide-out shopping cart
{% endcomment %}

<div class="cart-drawer" id="cartDrawer">
  <div class="cart-overlay" onclick="toggleCart()"></div>
  <div class="cart-panel">
    <div class="cart-header">
      <h2>{{ 'cart.title' | t }}</h2>
      <button class="cart-close" onclick="toggleCart()" aria-label="Close cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <div class="cart-content">
      {%- if cart.item_count > 0 -%}
        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <div class="cart-item-image">
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}">
              </div>
              <div class="cart-item-details">
                <p class="cart-item-name">{{ item.product.title }}</p>
                <p class="cart-item-variant">{{ item.variant.title }}</p>
                <p class="cart-item-price">{{ item.final_line_price | money }}</p>
                <div class="cart-item-qty">
                  <span>Qty: {{ item.quantity }}</span>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        
        <div class="cart-footer">
          <div class="cart-subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-shipping-note">{{ 'cart.shipping_note' | t }}</p>
          <button class="checkout-btn" name="checkout">
            {{ 'cart.checkout' | t }}
          </button>
          <button class="continue-btn" onclick="toggleCart()">
            {{ 'cart.continue_shopping' | t }}
          </button>
        </div>
      {%- else -%}
        <div class="cart-empty">
          <p>{{ 'cart.empty' | t }}</p>
          <button class="continue-btn" onclick="toggleCart()">
            {{ 'cart.continue_shopping' | t }}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  function toggleCart() {
    const drawer = document.getElementById('cartDrawer');
    drawer.classList.toggle('active');
    document.body.style.overflow = drawer.classList.contains('active') ? 'hidden' : '';
  }
  
  // Open cart when clicking on cart icon in header
  document.querySelector('.cart-link')?.addEventListener('click', function(e) {
    e.preventDefault();
    toggleCart();
  });
</script>

<style>
  .cart-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
  }
  
  .cart-drawer.active {
    display: block;
  }
  
  .cart-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }
  
  .cart-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 400px;
    background: hsl(var(--background));
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  
  .cart-drawer.active .cart-panel {
    transform: translateX(0);
  }
  
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid hsl(var(--border));
  }
  
  .cart-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0;
  }
  
  .cart-close {
    background: transparent;
    border: none;
    padding: 8px;
    border-radius: 8px;
    color: hsl(var(--foreground) / 0.7);
    cursor: pointer;
  }
  
  .cart-close:hover {
    background: hsl(var(--accent));
  }
  
  .cart-content {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }
  
  .cart-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .cart-item {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  
  .cart-item-image {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--card));
  }
  
  .cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .cart-item-details {
    flex: 1;
  }
  
  .cart-item-name {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0 0 4px;
  }
  
  .cart-item-variant {
    font-family: 'Karla', sans-serif;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    margin: 0 0 8px;
  }
  
  .cart-item-price {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    color: hsl(var(--foreground));
    margin: 0 0 8px;
  }
  
  .cart-item-qty {
    font-family: 'Karla', sans-serif;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  
  .cart-footer {
    border-top: 1px solid hsl(var(--border));
    padding: 24px;
  }
  
  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    font-family: 'Karla', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin-bottom: 8px;
  }
  
  .cart-shipping-note {
    font-family: 'Karla', sans-serif;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    margin: 0 0 16px;
  }
  
  .checkout-btn,
  .continue-btn {
    width: 100%;
    padding: 14px 24px;
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .checkout-btn {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    margin-bottom: 12px;
  }
  
  .checkout-btn:hover {
    background: hsl(var(--primary) / 0.9);
  }
  
  .continue-btn {
    background: transparent;
    color: hsl(var(--foreground));
    border: 1px solid hsl(var(--border));
  }
  
  .continue-btn:hover {
    background: hsl(var(--accent));
  }
  
  .cart-empty {
    text-align: center;
    padding: 40px 20px;
  }
  
  .cart-empty p {
    font-family: 'Karla', sans-serif;
    font-size: 16px;
    color: hsl(var(--muted-foreground));
    margin: 0 0 24px;
  }
</style>
