{% comment %}
  Product Card Snippet - Reusable product card component
{% endcomment %}

<div class="product-card">
  <div class="product-image-wrapper">
    {% if product.tags contains 'Bestseller' or product.tags contains 'New' %}
      <span class="product-badge">{{ product.tags | first }}</span>
    {% endif %}
    {% if product.featured_image %}
      <img 
        src="{{ product.featured_image | image_url: width: 600 }}" 
        alt="{{ product.title }}"
        loading="lazy"
      >
    {% else %}
      <img 
        src="https://vibe.filesafe.space/1788045264032144954/assets/4b441dca-e975-435e-88e9-f11ee3521474.png" 
        alt="{{ product.title }}"
        loading="lazy"
      >
    {% endif %}
  </div>
  <div class="product-info">
    {% if product.variants.first.sku %}
      <p class="product-size">{{ product.variants.first.sku }}</p>
    {% else %}
      <p class="product-size">{{ product.variants.first.title }}</p>
    {% endif %}
    <h3 class="product-name">{{ product.title }}</h3>
    {% if product.description %}
      <p class="product-subtitle">{{ product.description | truncatewords: 10 }}</p>
    {% endif %}
    <p class="product-blurb">{{ product.metafields.global.blurb | default: product.description | strip_html | truncatewords: 15 }}</p>
    <div class="product-price-row">
      <div class="product-price-wrapper">
        <span class="product-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="product-compare-price">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
      <button 
        class="add-to-bag-btn" 
        onclick="document.getElementById('cartDrawer').classList.add('active')"
        {% unless product.available %}disabled{% endunless %}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {% if product.available %}
          Add to Bag
        {% else %}
          Sold Out
        {% endif %}
      </button>
    </div>
  </div>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-elegant);
    transition: transform 0.2s;
  }
  
  .product-card:hover {
    transform: translateY(-4px);
  }
  
  .product-image-wrapper {
    position: relative;
    aspect-ratio: 1;
    background: hsl(var(--muted));
    overflow: hidden;
  }
  
  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: hsl(var(--secondary));
    color: hsl(var(--secondary-foreground));
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 9999px;
    z-index: 10;
  }
  
  .product-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  
  .product-card:hover .product-image-wrapper img {
    transform: scale(1.05);
  }
  
  .product-info {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .product-size {
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--secondary));
    margin: 0 0 4px;
  }
  
  .product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0 0 4px;
    line-height: 1.3;
  }
  
  .product-subtitle {
    font-family: 'Karla', sans-serif;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    margin: 0 0 12px;
  }
  
  .product-blurb {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
    flex: 1;
    margin: 0 0 16px;
  }
  
  .product-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }
  
  .product-price-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  
  .product-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 600;
    color: hsl(var(--primary));
  }
  
  .product-compare-price {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    text-decoration: line-through;
  }
  
  .add-to-bag-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-family: 'Karla', sans-serif;
    font-size: 13px;
    font-weight: 600;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background 0.2s;
  }
  
  .add-to-bag-btn:not(:disabled):hover {
    background: hsl(var(--primary) / 0.9);
  }
  
  .add-to-bag-btn:disabled {
    background: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
    cursor: not-allowed;
  }
</style>
