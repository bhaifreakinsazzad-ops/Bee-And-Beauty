{% comment %}
  Homepage Template - Bee & Beauty Storefront
{% endcomment %}

<!-- Hero Section -->
<section class="hero-section">
  <div class="hero-container">
    <div class="hero-content">
      <p class="hero-eyebrow">Bee You, Be Beauty!</p>
      <h1 class="hero-title">Nature, refined.</h1>
      <p class="hero-description">
        Glow like never before. Shine with confidence — because beauty isn't just a look, it's a lifestyle. Meet 
        <span class="highlight">The Ordinary Serum</span>, the honey-propolis ritual behind it.
      </p>
      <div class="hero-actions">
        <a href="#serum" class="btn btn-primary">
          Shop The Serum — $48
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="#story" class="hero-link">Read our story</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">96%</span>
          <span class="stat-label">saw improved radiance</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value">14 days</span>
          <span class="stat-label">to visible refinement</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value">100%</span>
          <span class="stat-label">cruelty-free formula</span>
        </div>
      </div>
    </div>
    <div class="hero-image-wrapper">
      <img 
        src="https://vibe.filesafe.space/1788045264032144954/assets/f84a9209-4dba-4109-b95d-703fec1ed74d.png" 
        alt="The Ordinary Serum, an amber dropper bottle by Bee & Beauty"
        class="hero-image"
        loading="eager"
      >
    </div>
  </div>
</section>

<!-- Category Showcase -->
<section class="category-showcase">
  <div class="category-grid">
    <a href="#serum" class="category-card">
      <img src="https://vibe.filesafe.space/1788045264032144954/assets/4b441dca-e975-435e-88e9-f11ee3521474.png" alt="The Serum">
      <span>The Serum</span>
    </a>
    <a href="#bundles" class="category-card">
      <img src="https://vibe.filesafe.space/1788045264032144954/assets/4d0c2d12-6c3e-4a99-b4d6-ae70d713ac66.png" alt="Bundles">
      <span>Bundles</span>
    </a>
    <a href="#gifting" class="category-card">
      <img src="https://vibe.filesafe.space/1788045264032144954/assets/05c6bf82-c8ea-4704-b9d4-995a619fcb26.png" alt="Gifting">
      <span>Gifting</span>
    </a>
    <a href="#minis" class="category-card">
      <img src="https://vibe.filesafe.space/1788045264032144954/assets/4fc72cd3-4beb-4346-bcc1-5351b957301b.png" alt="Minis">
      <span>Minis</span>
    </a>
  </div>
</section>

<!-- Product Section: The Serum -->
<section id="serum" class="product-section">
  <div class="product-section-header">
    <p class="section-eyebrow">Our Hero Formula</p>
    <h2 class="section-title">The Ordinary Serum</h2>
    <p class="section-description">
      Raw honey, purified propolis and royal jelly peptides — the proof-of-concept behind everything Bee & Beauty makes.
    </p>
  </div>
  
  <div class="product-grid">
    {% for product in collections['the-ordinary-serum'].products limit: 4 %}
      {% render 'product-card', product: product %}
    {% else %}
      <!-- Default product card if no products exist yet -->
      <div class="product-card">
        <div class="product-image-wrapper">
          <span class="product-badge">Bestseller</span>
          <img src="https://vibe.filesafe.space/1788045264032144954/assets/4b441dca-e975-435e-88e9-f11ee3521474.png" alt="The Ordinary Serum">
        </div>
        <div class="product-info">
          <p class="product-size">30ml</p>
          <h3 class="product-name">The Ordinary Serum</h3>
          <p class="product-subtitle">Honey Propolis Renewal Concentrate</p>
          <p class="product-blurb">Our flagship formula — raw honey, purified propolis and royal jelly peptides for visible refinement in 14 days.</p>
          <div class="product-price-row">
            <span class="product-price">$48</span>
            <button class="add-to-bag-btn" onclick="toggleCart()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              Add to Bag
            </button>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<!-- Ingredient Banner -->
<section class="ingredient-banner">
  <div class="ingredient-content">
    <div class="ingredient-text">
      <h3>From the Hive to Your Skin</h3>
      <p>
        Our formulas harness nature's most powerful ingredients: raw honey for hydration, 
        propolis for barrier support, and royal jelly peptides for renewal. Each component 
        is carefully sourced from small apiaries and paired with clinically-proven actives.
      </p>
    </div>
    <div class="ingredient-highlights">
      <div class="highlight">
        <span class="highlight-icon">🍯</span>
        <span>Raw Honey Extract</span>
      </div>
      <div class="highlight">
        <span class="highlight-icon">🐝</span>
        <span>Purified Propolis</span>
      </div>
      <div class="highlight">
        <span class="highlight-icon">✨</span>
        <span>Royal Jelly Peptides</span>
      </div>
    </div>
  </div>
</section>

<!-- Product Section: Bundles -->
<section id="bundles" class="product-section muted">
  <div class="product-section-header">
    <p class="section-eyebrow">More Ritual, Less Spend</p>
    <h2 class="section-title">Bundles & Value Sets</h2>
    <p class="section-description">
      Stock up or share the ritual — bundles built around The Ordinary Serum.
    </p>
  </div>
  
  <div class="product-grid">
    {% for product in collections['bundles'].products limit: 4 %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
</section>

<!-- Trust Badges -->
<section class="trust-section">
  <div class="trust-grid">
    <div class="trust-badge">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <h4>Dermatologist-Reviewed</h4>
      <p>Every batch reviewed before it reaches your door</p>
    </div>
    <div class="trust-badge">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
        <line x1="12" y1="19" x2="12" y2="23"></line>
        <line x1="8" y1="23" x2="16" y2="23"></line>
      </svg>
      <h4>Cruelty-Free</h4>
      <p>Never tested on animals, ever</p>
    </div>
    <div class="trust-badge">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
      <h4>Small-Batch Sourced</h4>
      <p>Honey & propolis from accountable apiaries</p>
    </div>
    <div class="trust-badge">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
        <path d="M3 3v5h5"></path>
      </svg>
      <h4>Easy 14-Day Returns</h4>
      <p>Not glowing? Send it back, no questions</p>
    </div>
  </div>
</section>

<!-- Product Section: Gifting -->
<section id="gifting" class="product-section">
  <div class="product-section-header">
    <p class="section-eyebrow">Gift the Glow</p>
    <h2 class="section-title">Gifting Edits</h2>
    <p class="section-description">
      Thoughtfully wrapped sets for the beauty-lover in your life.
    </p>
  </div>
  
  <div class="product-grid">
    {% for product in collections['gifting'].products limit: 4 %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
</section>

<!-- Product Section: Minis -->
<section id="minis" class="product-section muted">
  <div class="product-section-header">
    <p class="section-eyebrow">Try It First</p>
    <h2 class="section-title">Travel Minis</h2>
    <p class="section-description">
      Pocket-sized versions of The Ordinary Serum, perfect for first-timers and frequent flyers.
    </p>
  </div>
  
  <div class="product-grid">
    {% for product in collections['minis'].products limit: 4 %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
</section>

<!-- Testimonials -->
<section class="testimonial-section">
  <div class="testimonial-grid">
    <div class="testimonial-card">
      <blockquote>
        "My dermatologist asked what I was using. Two weeks in and my skin has never felt this calm."
      </blockquote>
      <cite>
        <span class="testimonial-name">Amara T.</span>
        <span class="testimonial-detail">Verified Bee & Beauty customer</span>
      </cite>
    </div>
    <div class="testimonial-card">
      <blockquote>
        "The ritual itself feels like a five-minute vacation. The glow is just a bonus at this point."
      </blockquote>
      <cite>
        <span class="testimonial-name">Priya N.</span>
        <span class="testimonial-detail">Verified Bee & Beauty customer</span>
      </cite>
    </div>
    <div class="testimonial-card">
      <blockquote>
        "I've tried three 'clean' serums this year. This is the only one that actually explains what's in it."
      </blockquote>
      <cite>
        <span class="testimonial-name">Farah K.</span>
        <span class="testimonial-detail">Verified Bee & Beauty customer</span>
      </cite>
    </div>
  </div>
</section>

<style>
  /* Hero Section */
  .hero-section {
    background: var(--gradient-hero);
    padding: 64px 16px;
  }
  
  @media (min-width: 640px) {
    .hero-section {
      padding: 96px 32px;
    }
  }
  
  @media (min-width: 1024px) {
    .hero-section {
      padding: 112px 32px;
    }
  }
  
  .hero-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    gap: 40px;
    align-items: center;
  }
  
  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }
  
  .hero-content {
    color: hsl(var(--primary-foreground));
  }
  
  .hero-eyebrow {
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: hsl(var(--secondary));
    margin: 0;
  }
  
  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 40px;
    font-weight: 600;
    line-height: 1.05;
    color: hsl(var(--primary-foreground));
    margin: 16px 0;
  }
  
  @media (min-width: 640px) {
    .hero-title {
      font-size: 48px;
    }
  }
  
  @media (min-width: 1024px) {
    .hero-title {
      font-size: 64px;
    }
  }
  
  .hero-description {
    font-family: 'Karla', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: hsl(var(--primary-foreground) / 0.8);
    max-width: 448px;
    margin: 20px 0;
  }
  
  .hero-description .highlight {
    color: hsl(var(--secondary));
  }
  
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    font-family: 'Karla', sans-serif;
    font-size: 16px;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .btn-primary {
    background: hsl(var(--secondary));
    color: hsl(var(--secondary-foreground));
  }
  
  .btn-primary:hover {
    background: hsl(var(--secondary) / 0.9);
  }
  
  .hero-link {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--primary-foreground) / 0.8);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  
  .hero-link:hover {
    color: hsl(var(--primary-foreground));
  }
  
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    margin-top: 40px;
  }
  
  .stat {
    display: flex;
    flex-direction: column;
  }
  
  .stat-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 600;
    color: hsl(var(--secondary));
  }
  
  .stat-label {
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    color: hsl(var(--primary-foreground) / 0.6);
  }
  
  .stat-divider {
    width: 1px;
    height: 40px;
    background: hsl(var(--primary-foreground) / 0.2);
  }
  
  .hero-image-wrapper {
    position: relative;
  }
  
  .hero-image-wrapper::before {
    content: '';
    position: absolute;
    inset: -24px;
    background: hsl(var(--secondary) / 0.2);
    border-radius: 9999px;
    filter: blur(40px);
    z-index: -1;
  }
  
  .hero-image {
    width: 100%;
    border-radius: 24px;
    box-shadow: var(--shadow-elegant);
  }
  
  /* Category Showcase */
  .category-showcase {
    padding: 48px 16px;
    background: hsl(var(--background));
  }
  
  @media (min-width: 640px) {
    .category-showcase {
      padding: 64px 32px;
    }
  }
  
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: 1280px;
    margin: 0 auto;
  }
  
  @media (min-width: 640px) {
    .category-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
  
  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 16px;
    border-radius: 16px;
    transition: all 0.2s;
  }
  
  .category-card:hover {
    background: hsl(var(--accent));
  }
  
  .category-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
  }
  
  .category-card span {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--foreground));
  }
  
  /* Product Sections */
  .product-section {
    padding: 64px 16px;
    max-width: 1280px;
    margin: 0 auto;
  }
  
  @media (min-width: 640px) {
    .product-section {
      padding: 96px 32px;
    }
  }
  
  .product-section.muted {
    background: hsl(var(--muted));
    border-radius: 24px;
    margin: 48px auto;
  }
  
  .product-section-header {
    text-align: center;
    margin-bottom: 48px;
  }
  
  .section-eyebrow {
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: hsl(var(--secondary));
    margin: 0 0 12px;
  }
  
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0 0 12px;
  }
  
  @media (min-width: 640px) {
    .section-title {
      font-size: 40px;
    }
  }
  
  .section-description {
    font-family: 'Karla', sans-serif;
    font-size: 16px;
    color: hsl(var(--muted-foreground));
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.7;
  }
  
  .product-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
  
  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  .product-card {
    display: flex;
    flex-direction: column;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-elegant);
    transition: transform 0.2s;
  }
  
  .product-card:hover {
    transform: translateY(-4px);
  }
  
  .product-image-wrapper {
    position: relative;
    aspect-ratio: 1;
    background: hsl(var(--muted));
    overflow: hidden;
  }
  
  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: hsl(var(--secondary));
    color: hsl(var(--secondary-foreground));
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 9999px;
    z-index: 10;
  }
  
  .product-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  
  .product-card:hover .product-image-wrapper img {
    transform: scale(1.05);
  }
  
  .product-info {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .product-size {
    font-family: 'Karla', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--secondary));
    margin: 0 0 4px;
  }
  
  .product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0 0 4px;
    line-height: 1.3;
  }
  
  .product-subtitle {
    font-family: 'Karla', sans-serif;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    margin: 0 0 12px;
  }
  
  .product-blurb {
    font-family: 'Karla', sans-serif;
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
    flex: 1;
    margin: 0 0 16px;
  }
  
  .product-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }
  
  .product-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 600;
    color: hsl(var(--primary));
  }
  
  .add-to-bag-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-family: 'Karla', sans-serif;
    font-size: 13px;
    font-weight: 600;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background 0.2s;
  }
  
  .add-to-bag-btn:hover {
    background: hsl(var(--primary) / 0.9);
  }
  
  /* Ingredient Banner */
  .ingredient-banner {
    background: linear-gradient(135deg, hsl(var(--honey-gold)) 0%, hsl(var(--honey-light)) 100%);
    padding: 48px 16px;
  }
  
  @media (min-width: 640px) {
    .ingredient-banner {
      padding: 64px 32px;
    }
  }
  
  .ingredient-content {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
  }
  
  @media (min-width: 768px) {
    .ingredient-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  
  .ingredient-text {
    flex: 1;
    max-width: 560px;
  }
  
  .ingredient-text h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 600;
    color: hsl(var(--plum-deep));
    margin: 0 0 16px;
  }
  
  @media (min-width: 640px) {
    .ingredient-text h3 {
      font-size: 32px;
    }
  }
  
  .ingredient-text p {
    font-family: 'Karla', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: hsl(var(--plum-deep) / 0.8);
    margin: 0;
  }
  
  .ingredient-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  
  .highlight {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: hsl(var(--cream-bg) / 0.5);
    border-radius: 9999px;
  }
  
  .highlight-icon {
    font-size: 20px;
  }
  
  .highlight span:last-child {
    font-family: 'Karla', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: hsl(var(--plum-deep));
  }
  
  /* Trust Section */
  .trust-section {
    padding: 64px 16px;
    background: hsl(var(--background));
  }
  
  @media (min-width: 640px) {
    .trust-section {
      padding: 96px 32px;
    }
  }
  
  .trust-grid {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    max-width: 1280px;
    margin: 0 auto;
  }
  
